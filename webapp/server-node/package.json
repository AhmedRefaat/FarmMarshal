{
  "name": "agritasks-server-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AgriTasks REST API — Trail-2 (Node.js + Fastify + TypeScript)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "schema:apply": "psql \"$DATABASE_URL\" -f db/schema.sql"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
